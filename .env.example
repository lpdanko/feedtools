APP_ENV=production
APP_BASE_URL=https://feedtools.example.com
APP_BASIC_AUTH_ENABLED=0
APP_BASIC_AUTH_REALM=FeedTools
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASS=
APP_BASIC_AUTH_PASS_HASH=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=feedtools
DB_USER=feedtools
DB_PASS=change-me
DB_CHARSET=utf8mb4
DB_TIMEOUT_SEC=5

MAX_UPLOAD_BYTES=1073741824
SAMPLE_OFFERS=3

LLM_PROVIDER=openai
LLM_API_FORMAT=responses
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_DEFAULT=gpt-5.5
LLM_VISION_MODEL_DEFAULT=
LLM_MODELS=gpt-5.5,gpt-5.4,gpt-5.3
LLM_MODEL_PREFIX=
LLM_MODEL_ALIASES_JSON=
LLM_REMOTE_IMAGE_MAX_BYTES=10485760
LLM_REMOTE_IMAGE_TIMEOUT_SEC=20
LLM_TIMEOUT_SEC=60
LLM_RETRIES=4
LLM_RETRY_BASE_DELAY_MS=250
LLM_AUTH_TYPE=bearer
LLM_AUTH_HEADER=Authorization
LLM_AUTH_VALUE_PREFIX=
LLM_TLS_VERIFY=1
LLM_IP_RESOLVE=
LLM_EXTRA_HEADERS_JSON=
LLM_RESPONSE_CACHE_ENABLED=1
LLM_RESPONSE_CACHE_TTL_SEC=2592000
LLM_RESPONSE_CACHE_DIR=
LLM_PROMPT_CACHE_KEY_ENABLED=1
LLM_PROMPT_CACHE_RETENTION=
LLM_REQUEST_LOG_ENABLED=1
LLM_REQUEST_LOG_MAX_REQUEST_CHARS=200000
LLM_REQUEST_LOG_MAX_RESPONSE_CHARS=200000
LLM_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
LLM_OAUTH_SCOPE=GIGACHAT_API_PERS
LLM_OAUTH_CACHE_FILE=

# Legacy OpenAI variables are still read as fallback when LLM_* is empty.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_DEFAULT=gpt-5.5
OPENAI_MODELS=gpt-5.5,gpt-5.4,gpt-5.3
OPENAI_VISION_MODEL_DEFAULT=
OPENAI_TIMEOUT_SEC=60
OPENAI_RETRIES=4
OPENAI_RETRY_BASE_DELAY_MS=250
OPENAI_RESPONSE_CACHE_ENABLED=1
OPENAI_RESPONSE_CACHE_TTL_SEC=2592000
OPENAI_RESPONSE_CACHE_DIR=
OPENAI_PROMPT_CACHE_KEY_ENABLED=1
OPENAI_PROMPT_CACHE_RETENTION=
OPENAI_REQUEST_LOG_ENABLED=1
OPENAI_REQUEST_LOG_MAX_REQUEST_CHARS=200000
OPENAI_REQUEST_LOG_MAX_RESPONSE_CHARS=200000

# Yandex AI Studio shortcut variables.
# When LLM_PROVIDER=yandex, YANDEX_API_KEY is used as fallback for LLM_API_KEY.
# When YANDEX_FOLDER_ID is set, UI model yandexgpt-5.1/latest is sent as
# gpt://<YANDEX_FOLDER_ID>/yandexgpt-5.1/latest.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_MODEL_DEFAULT=yandexgpt-5.1/latest
YANDEX_VISION_MODEL_DEFAULT=gemma-3-27b-it
YANDEX_MODELS=yandexgpt-5.1/latest,yandexgpt-5-pro/latest,yandexgpt-5-lite/latest,aliceai-llm/latest,gemma-3-27b-it
YANDEX_MODEL_PREFIX=
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_FOLDER_ID=

# Gemini shortcut variables.
# The Gemini API is called through Google's OpenAI-compatible endpoint.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL_DEFAULT=gemini-2.5-pro
GEMINI_VISION_MODEL_DEFAULT=gemini-2.5-flash
GEMINI_MODELS=gemini-3.1-pro-preview,gemini-2.5-pro,gemini-3-flash-preview,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3.1-flash-lite-preview
GEMINI_MODEL_ALIASES_JSON=
GEMINI_TIMEOUT_SEC=90
GEMINI_RETRIES=0
GEMINI_RETRY_BASE_DELAY_MS=500
GEMINI_IP_RESOLVE=
GOOGLE_AI_API_KEY=

APP_RETENTION_LLM_REQUEST_DAYS=1
APP_RETENTION_PRICE_PUSH_DAYS=1
APP_RETENTION_OPERATION_OUTPUT_DAYS=1
APP_RETENTION_ORDER_SNAPSHOT_HISTORY_DAYS=7

OZON_CLIENT_ID=
OZON_API_KEY=
OZON_BASE_URL=https://api-seller.ozon.ru
OZON_TIMEOUT_SEC=30

WB_API_TOKEN=
WB_CONTENT_TOKEN=
WB_PROMOTION_TOKEN=
WB_MARKETPLACE_TOKEN=
WB_CONTENT_BASE_URL=https://content-api.wildberries.ru
WB_MARKETPLACE_BASE_URL=https://marketplace-api.wildberries.ru
WB_STATISTICS_BASE_URL=https://statistics-api.wildberries.ru
WB_TIMEOUT_SEC=30
WB_LOCALE=ru

REMOTE_IMAGES_ENABLED=0
REMOTE_IMAGES_DRIVER=ftp
REMOTE_IMAGES_BASE_URL=
REMOTE_IMAGES_PATH_PREFIX=feedtools/blur
REMOTE_IMAGES_FTP_HOST=
REMOTE_IMAGES_FTP_PORT=21
REMOTE_IMAGES_FTP_USER=
REMOTE_IMAGES_FTP_PASS=
REMOTE_IMAGES_FTP_ROOT_DIR=
REMOTE_IMAGES_FTP_SSL=0
REMOTE_IMAGES_FTP_PASSIVE=1
REMOTE_IMAGES_FTP_TIMEOUT=30
REMOTE_IMAGES_HTTP_ENDPOINT=
REMOTE_IMAGES_HTTP_AUTH_TYPE=bearer
REMOTE_IMAGES_HTTP_BEARER=
REMOTE_IMAGES_HTTP_USER=
REMOTE_IMAGES_HTTP_PASS=
REMOTE_IMAGES_HTTP_TIMEOUT=45

WORKER_AUTO_SPAWN=0
WORKER_PHP_BIN=/usr/bin/php
WORKER_SCRIPT=/var/www/feedtools/bin/worker.php
WORKER_MAX_PARALLEL=3
WORKER_PRICE_TOOL_MAX_PARALLEL=3
STOCKS_TOOL_AUTOMATION_MAX_PARALLEL=1
WORKER_MARKETPLACE_DATA_MAX_PARALLEL=1
WORKER_SUPPLIER_FEED_MAX_PARALLEL=1
