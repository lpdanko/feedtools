[Unit]
Description=FeedTools background worker
After=network.target mariadb.service mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/feedtools
EnvironmentFile=-/var/www/feedtools/.env
ExecStart=/usr/bin/php /var/www/feedtools/bin/worker.php --loop --exclude-op-type=master_mobile_feed
KillMode=process
Restart=always
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
