[Unit]
Description=FeedTools Price Tool background worker
After=network.target mariadb.service mysql.service

[Service]
Type=simple
WorkingDirectory=/var/www/feedtools
User=www-data
Group=www-data
Environment=WORKER_PRICE_TOOL_MAX_PARALLEL=3
Environment=WORKER_WB_PROMOTIONS_MAX_PARALLEL=1
ExecStart=/usr/bin/php /var/www/feedtools/bin/worker.php --loop --only-op-types=ozon_sync_actions,ozon_push_selected_feeds,wb_push_selected_feeds,yandex_push_selected_feeds,wb_sync_promotions,wb_import_promotion_xlsx_folder,wb_download_promotion_xlsx
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
